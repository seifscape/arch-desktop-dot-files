// ────────── Waybar Config ──────────

{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "fixed-center": true,

  "modules-left": ["custom/logo", "clock", "custom/updates", "custom/maintain", "custom/media", "custom/cava"],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "custom/docker",
    "custom/tailscale",
    "pulseaudio",
    "network",
    "bluetooth",
    "memory",
    "custom/notifications",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format": "{id}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  
  "bluetooth": {
    "on-click": "blueman-manager",
  	"format": "{icon}",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲"
    },
  	"format-disabled": "",
    "format-connected": "󰂱",
  	"tooltip-format": "{controller_alias}\t{controller_address}",
  	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
  	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  	"on-click": "~/.config/rofi/bluetooth/rofi-bluetooth"
},

  "memory": {
    "interval": 5,
    "format": "󰍛 {}%",
    "max-length": 6,
    "on-click": "ghostty --title=btop --window-width=141 --window-height=36 -e btop"
  },

  "tray": {
    "spacing": 10,
    "icon-size": 16
  },

  // Not waybar's `mpris` module: it segfaults when a player quits. See scripts/media.sh.
  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "hide-empty-text": true,
    "signal": 8,
    "on-click": "sh -c 'playerctl play-pause; sleep 0.4; pkill -RTMIN+8 waybar'",
    "on-click-right": "sh -c 'playerctl next; sleep 0.6; pkill -RTMIN+8 waybar'",
    "on-click-middle": "ghostty --title=cliamp --window-width=111 --window-height=30 -e cliamp"
  },

  "clock": {
    "tooltip-format": "{calendar}",
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a, %d %b %Y}"
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",

    "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",

    "on-click": "ghostty --title=nmtui --window-width=100 --window-height=25 -e nmtui",

    "interval": 5,
    "nospacing": 1
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰋋 {volume}%",
    "format-bluetooth-muted": "󰟎 {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{desc} · {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 1,
    "nospacing": 1
  },

  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/rofi/launchers/type-1/launcher.sh &"
  },


  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 1800,
    "signal": 10,
    "on-click": "ghostty --title=update --window-width=120 --window-height=32 -e sh -c 'yay; pkill -RTMIN+10 waybar'"
  },

  // Days since ~/scripts/maintain.sh last finished; red after a week. Hidden if it never ran here.
  "custom/maintain": {
    "exec": "~/.config/waybar/scripts/maintain-age.sh",
    "return-type": "json",
    "interval": 3600,
    "hide-empty-text": true,
    "on-click": "~/.config/hypr/scripts/maintain-popup.sh"
  },

  // 12-bar visualizer; waybar's own cava module isn't in Arch's build. See scripts/cava.sh.
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "format": "{}"
  },

  "custom/docker": {
    "exec": "~/.config/waybar/scripts/docker.sh",
    "return-type": "json",
    "interval": 15,
    "hide-empty-text": true,
    "on-click": "ghostty --title=lazydocker --window-width=160 --window-height=44 -e lazydocker"
  },

  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale.sh",
    "return-type": "json",
    "interval": 30,
    "hide-empty-text": true
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click": "dunstctl history-pop",
    "on-click-right": "dunstctl history-clear; dunstctl close-all",
    "on-click-middle": "dunstctl set-paused toggle"
  },

  "custom/power": {
    "format": "󰤆",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu/type-2/powermenu.sh &"
  }
}
